DOCKER_POSTGRES_UID=
DOCKER_POSTGRES_GID=

# POSTGRES ENV
POSTGRES_DB=zabbix
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=

# ZABBIX ENV
DB_SERVER_HOST=postgres
DB_SERVER_PORT=5432
ZBX_SERVER_HOST=server
PHP_TZ=Europe/Warsaw

# WEB SSL
ZBX_WEB_CERT_FILE=/etc/ssl/nginx/ssl.crt
ZBX_WEB_KEY_FILE=/etc/ssl/nginx/ssl.key

# AGENT SSL
ZBX_TLSCONNECT=psk
ZBX_TLSACCEPT=psk
ZBX_TLSPSKIDENTITY=agent-psk-01
ZBX_TLSPSKFILE=/var/lib/zabbix/enc/zabbix_agent.psk